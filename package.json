{
  "name": "goal-tracker-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:all": "npm run dev",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:api": "esbuild server/src/serverless.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:better-sqlite3",
    "build": "npm run build:client && npm run build:api",
    "build:server": "npm run build --prefix server",
    "db:push": "npm run db:push --prefix server",
    "db:sync": "npm run db:sync --prefix server",
    "db:migrate": "npm run db:migrate --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "vercel": "^64.2.0"
  }
}
